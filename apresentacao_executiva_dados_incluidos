        <button onclick="nextSlide()" class="px-5 py-2.5 rounded-xl bg-brand-blue hover:bg-brand-lightBlue text-white font-semibold text-xs md:text-sm transition flex items-center gap-2 shadow">
            Próximo <i class="fa-solid fa-arrow-right"></i>
        </button>
    </footer>

    <script>
        let currentSlide = 1;
        const totalSlides = 6;

        function updateSlideUI() {
            document.querySelectorAll('.slide-page').forEach(slide => {
                slide.classList.remove('active');
            });

            const activeSlide = document.getElementById(`slide-${currentSlide}`);
            if (activeSlide) activeSlide.classList.add('active');

            document.getElementById('slideCounterBadge').innerText = `${currentSlide}/${totalSlides}`;

            const dotsContainer = document.getElementById('dotsContainer');
            dotsContainer.innerHTML = '';
            for (let i = 1; i <= totalSlides; i++) {
                const dot = document.createElement('button');
                dot.className = `w-3 h-3 rounded-full transition-all ${i === currentSlide ? 'bg-brand-blue w-6' : 'bg-slate-700 hover:bg-slate-500'}`;
                dot.onclick = () => goToSlide(i);
                dotsContainer.appendChild(dot);
            }
        }

        function nextSlide() {
            if (currentSlide < totalSlides) {
                currentSlide++;
                updateSlideUI();
            }
        }

        function prevSlide() {
            if (currentSlide > 1) {
                currentSlide--;
                updateSlideUI();
            }
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlideUI();
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'Space') nextSlide();
            if (e.key === 'ArrowLeft') prevSlide();
        });

        function toggleFullscreen() {
            const container = document.getElementById('presentationContainer');
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => alert(`Erro: ${err.message}`));
            } else {
                document.exitFullscreen();
            }
        }

        function toggleAssetPanel() {
            const panel = document.getElementById('assetPanel');
            panel.classList.toggle('hidden');
        }

        function handleLogoUpload(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    localStorage.setItem('irrigamax_logo', dataUrl);
                    applyLogo(dataUrl);
                };
                reader.readAsDataURL(file);
            }
        }

        function handleBgUpload(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    localStorage.setItem('irrigamax_bg', dataUrl);
                    applyBg(dataUrl);
                };
                reader.readAsDataURL(file);
            }
        }

        function applyLogo(src) {
            const container = document.getElementById('logoContainer');
            container.innerHTML = `<img src="${src}" alt="IrrigaMax Logo" class="h-8 md:h-10 w-auto object-contain">`;
        }

        function applyBg(src) {
            const viewport = document.getElementById('presentationContainer');
            viewport.style.backgroundImage = `url('${src}')`;
        }

        function removeCustomLogo() {
            localStorage.removeItem('irrigamax_logo');
            location.reload();
        }

        function removeCustomBg() {
            localStorage.removeItem('irrigamax_bg');
            location.reload();
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateSlideUI();
            const savedLogo = localStorage.getItem('irrigamax_logo');
            if (savedLogo) applyLogo(savedLogo);

            const savedBg = localStorage.getItem('irrigamax_bg');
            if (savedBg) applyBg(savedBg);
        });
    </script>
