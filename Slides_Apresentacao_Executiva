        /* Custom Styles & Animation */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1a202c;
            color: #2d3748;
            overflow-x: hidden;
        }

        /* Slide Container Aspect Ratio (16:9 standard slide ratio) */
        .slide-viewport {
            width: 100%;
            max-width: 1100px;
            aspect-ratio: 16 / 9;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        /* Background blur overlay with agricultural irrigation subtle theme */
        .slide-bg-overlay {
