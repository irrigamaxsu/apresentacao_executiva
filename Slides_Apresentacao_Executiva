        <i class="fa-solid fa-circle-check text-brand-green text-base"></i>
        <span id="toastMsg">Alterações salvas no modelo!</span>
    </div>

    <!-- JavaScript Navigation & Logic -->
    <script>
        let currentSlide = 1;
        const totalSlides = 6;

        function updateSlideView() {
            // Hide all slides
            for (let i = 1; i <= totalSlides; i++) {
                const slide = document.getElementById(`slide-${i}`);
                const dot = document.getElementById(`dot-${i}`);
                if (slide) {
                    slide.classList.remove('active');
                }
                if (dot) {
                    dot.className = "w-2.5 h-2.5 rounded-full bg-slate-600 transition-all";
                }
            }

            // Active current slide
            const activeSlide = document.getElementById(`slide-${currentSlide}`);
            const activeDot = document.getElementById(`dot-${currentSlide}`);
            
            if (activeSlide) {
                activeSlide.classList.add('active');
            }
            if (activeDot) {
                activeDot.className = "w-3.5 h-3.5 rounded-full bg-brand-blue shadow-md transition-all";
            }

            // Update badge text
            document.getElementById('slideCounterBadge').innerText = `${currentSlide}/${totalSlides}`;
        }

        function nextSlide() {
            if (currentSlide < totalSlides) {
                currentSlide++;
            } else {
                currentSlide = 1; // loop back
            }
            updateSlideView();
        }

        function prevSlide() {
            if (currentSlide > 1) {
                currentSlide--;
            } else {
                currentSlide = totalSlides;
            }
            updateSlideView();
        }

        function goToSlide(slideNum) {
            currentSlide = slideNum;
            updateSlideView();
        }

        // Keyboard arrow key navigation
        document.addEventListener('keydown', function(event) {
            // Ignore if editing text inside editable element
            if (document.activeElement && document.activeElement.isContentEditable) {
                return;
            }

            if (event.key === 'ArrowRight' || event.key === 'Space') {
                nextSlide();
            } else if (event.key === 'ArrowLeft') {
                prevSlide();
            }
        });

        // Fullscreen toggle
        function toggleFullscreen() {
            const container = document.getElementById('presentationContainer');
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => {
                    showToast(`Erro ao ativar ecrã inteiro: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
        }

        // Show Toast helper
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.innerText = message;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function toggleEditHelp() {
            showToast("Pode clicar em qualquer texto ou número nos slides para editar os valores!");
        }

        function resetData() {
            if (confirm("Deseja restaurar o texto e valores para o padrão inicial?")) {
                location.reload();
            }
        }

        // Touch Swipe gestures for Mobile
        let touchstartX = 0;
        let touchendX = 0;

        const container = document.getElementById('presentationContainer');
        container.addEventListener('touchstart', e => {
            touchstartX = e.changedTouches[0].screenX;
        });

        container.addEventListener('touchend', e => {
            touchendX = e.changedTouches[0].screenX;
            handleSwipe();
        });

        function handleSwipe() {
            if (touchendX < touchstartX - 40) nextSlide();
            if (touchendX > touchstartX + 40) prevSlide();
        }

        // Initialize view on load
        window.onload = function() {
            updateSlideView();
        }
    </script>
