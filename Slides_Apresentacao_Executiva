        <i class="fa-solid fa-circle-check text-brand-green text-base"></i>
        <span id="toastMsg">Imagem de fundo carregada e salva com sucesso!</span>
    </div>

    <script>
        let currentSlide = 1;
        const totalSlides = 6;

        // Slide Navigation Logic
        function updateSlideView() {
            for (let i = 1; i <= totalSlides; i++) {
                const slide = document.getElementById(`slide-${i}`);
                const dot = document.getElementById(`dot-${i}`);
                if (slide) slide.classList.remove('active');
                if (dot) dot.className = "w-2.5 h-2.5 rounded-full bg-slate-600 transition-all";
            }

            const activeSlide = document.getElementById(`slide-${currentSlide}`);
            const activeDot = document.getElementById(`dot-${currentSlide}`);
            
            if (activeSlide) activeSlide.classList.add('active');
            if (activeDot) activeDot.className = "w-3.5 h-3.5 rounded-full bg-brand-blue shadow-md transition-all";

            document.getElementById('slideCounterBadge').innerText = `${currentSlide}/${totalSlides}`;
        }

        function nextSlide() {
            currentSlide = (currentSlide < totalSlides) ? currentSlide + 1 : 1;
            updateSlideView();
        }

        function prevSlide() {
            currentSlide = (currentSlide > 1) ? currentSlide - 1 : totalSlides;
            updateSlideView();
        }

        function goToSlide(n) {
            currentSlide = n;
            updateSlideView();
        }

        // Toggle Asset Uploader Drawer
        function toggleAssetPanel() {
            const panel = document.getElementById('assetPanel');
            panel.classList.toggle('hidden');
        }

        // Handle Image Uploads & Local Storage
        function handleLogoUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    applyLogo(dataUrl);
                    localStorage.setItem('irrigamax_logo', dataUrl);
                    showToast('Logotipo atualizado e salvo localmente!');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function handleBgUpload(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    applyBg(dataUrl);
                    localStorage.setItem('irrigamax_bg', dataUrl);
                    showToast('Imagem de fundo aplicada e salva localmente!');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function applyLogo(url) {
            const container = document.getElementById('logoContainer');
            container.innerHTML = `<img src="${url}" alt="IrrigaMax Logo" class="max-h-10 w-auto object-contain"><span class="font-heading font-extrabold text-xs md:text-sm tracking-wider text-brand-charcoal uppercase">IRRIGAMAX</span>`;
        }

        function applyBg(url) {
            const container = document.getElementById('presentationContainer');
            container.style.backgroundImage = `url('${url}')`;
        }

        function removeCustomLogo() {
            localStorage.removeItem('irrigamax_logo');
            document.getElementById('logoContainer').innerHTML = `
                <svg id="defaultLogoSvg" class="w-7 h-7" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M50 8 C50 8, 80 42, 80 62 C80 78.5, 66.5 92, 50 92 C33.5 92, 20 78.5, 20 62 C20 42, 50 8, 50 8 Z" fill="#1C75BC"/>
                    <path d="M25 68 C 35 55, 65 55, 75 68 C 65 82, 35 82, 25 68 Z" fill="#559334"/>
                    <circle cx="50" cy="50" r="4" fill="white"/>
                </svg>
                <span id="logoText" class="font-heading font-extrabold text-xs md:text-sm tracking-wider text-brand-charcoal uppercase">IRRIGAMAX</span>
            `;
            showToast('Logotipo padrão restaurado.');
        }

        function removeCustomBg() {
            localStorage.removeItem('irrigamax_bg');
            document.getElementById('presentationContainer').style.backgroundImage = 'none';
            showToast('Fundo personalizado removido.');
        }

        // Load Saved Assets on App Startup
        function loadSavedAssets() {
            const savedLogo = localStorage.getItem('irrigamax_logo');
            const savedBg = localStorage.getItem('irrigamax_bg');

            if (savedLogo) applyLogo(savedLogo);
            if (savedBg) applyBg(savedBg);
        }

        // Keyboard & Touch
        document.addEventListener('keydown', function(e) {
            if (document.activeElement && document.activeElement.isContentEditable) return;
            if (e.key === 'ArrowRight' || e.key === 'Space') nextSlide();
            if (e.key === 'ArrowLeft') prevSlide();
        });

        function toggleFullscreen() {
            const container = document.getElementById('presentationContainer');
            if (!document.fullscreenElement) {
                container.requestFullscreen().catch(err => showToast(`Erro ao ativar tela cheia`));
            } else {
                document.exitFullscreen();
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => toast.classList.add('opacity-0', 'pointer-events-none'), 3500);
        }

        window.onload = function() {
            updateSlideView();
            loadSavedAssets();
        };
    </script>
